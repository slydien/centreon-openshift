diff --git a/.github/docker/centreon-web/alma9/entrypoint/container.d/00-init.sh b/.github/docker/centreon-web/alma9/entrypoint/container.d/00-init.sh
index e4b5cd4dc2..90ea41d691 100644
--- a/.github/docker/centreon-web/alma9/entrypoint/container.d/00-init.sh
+++ b/.github/docker/centreon-web/alma9/entrypoint/container.d/00-init.sh
@@ -1,3 +1,19 @@
 #!/bin/sh
+set -eux
 
 rm -f /tmp/docker.ready
+
+# Keep OpenShift arbitrary UID and Centreon users able to read/write new files.
+umask 0002
+#
+# Ensure the current arbitrary UID exists in /etc/passwd (OpenShift best practice)
+ensure_passwd_entry() {
+    uid="$(id -u)"
+    gid="$(id -g)"
+    if ! getent passwd "$uid" >/dev/null 2>&1; then
+        # name must be valid, home must exist or be writable-ish
+        echo "default:x:${uid}:${gid}:OpenShift UID:${HOME:-/tmp}:/sbin/nologin" >>/etc/passwd
+    fi
+}
+
+ensure_passwd_entry
