ARG REGISTRY_URL=docker.centreon.com/centreon
ARG FROM_IMAGE_VERSION=develop

FROM ${REGISTRY_URL}/centreon-web-alma9:${FROM_IMAGE_VERSION}

###############################################################################
# OpenShift compatibility overlay (Alma 9)
###############################################################################

# OpenShift helpers
COPY --chmod=755 ./common/fix-permissions /usr/local/bin/fix-permissions
COPY --chmod=440 ./common/openshift/sudoers /etc/sudoers.d/centreon-openshift
COPY --chmod=755 ./common/openshift/sudo-wrapper /usr/local/bin/sudo

COPY --chmod=660 ./web/patches/00-init.sh.patch /tmp/00-init.sh.patch
COPY --chmod=660 ./common/openshift/patches/systemctl.patch /tmp/systemctl.patch
COPY --chmod=660 ./common/openshift/patches/ignore-vmware-chgrp.patch /tmp/ignore-vmware-chgrp.patch
COPY --chmod=755 ./common/openshift/fix-poller-gen.py /usr/local/bin/fix-poller-gen.py
COPY --chmod=660 ./web/patches/ /tmp/web-patches/

RUN bash -e <<'EOF'
set -euo pipefail

# Replace sudo with wrapper
if [ -x /usr/bin/sudo ]; then
  mv /usr/bin/sudo /usr/bin/sudo.real
fi
ln -sf /usr/local/bin/sudo /usr/bin/sudo

# Uncomment include directory for specific Openshift sudoers file
sed -i 's/^#includedir/includedir/' /etc/sudoers

# -----------------------------------------------------------------------------
# 1) Relocate mutable /etc trees
# -----------------------------------------------------------------------------
mkdir -p /var/lib/centreon/

relocate_tree() {
  src="$1"
  name="$2"
  dst="/var/lib/centreon/${name}"

  mkdir -p "$dst"

  if [ -e "$src" ] && [ ! -L "$src" ]; then
    cp -a "$src"/. "$dst"/ 2>/dev/null || true
    rm -rf "$src"
  fi

  mkdir -p "$(dirname "$src")"
  ln -sfn "$dst" "$src"
}

relocate_tree /etc/centreon         etc/centreon
relocate_tree /etc/centreon-broker  etc/centreon-broker
relocate_tree /etc/centreon-gorgone etc/centreon-gorgone
relocate_tree /etc/centreon-engine  etc/centreon-engine
relocate_tree /var/lib/centreon-engine  var/lib/centreon-engine
relocate_tree /var/lib/centreon-broker  var/lib/centreon-broker
relocate_tree /var/lib/centreon-gorgone  var/lib/centreon-engine
relocate_tree /usr/share/centreon/www/install/tmp install/tmp

# Ensure gorgone keys are stable across restarts
/usr/local/bin/gorgone_key_generation.pl
chgrp 0 /var/lib/centreon-gorgone/.keys/rsakey.priv.pem /var/lib/centreon-gorgone/.keys/rsakey.pub.pem
chmod 0640 /var/lib/centreon-gorgone/.keys/rsakey.priv.pem
chmod 0644 /var/lib/centreon-gorgone/.keys/rsakey.pub.pem

# -----------------------------------------------------------------------------
# 2) Create + fix permissions for runtime/state paths
# -----------------------------------------------------------------------------
mkdir -p \
  /etc/sysconfig \
  /var/lib/centreon \
  /var/cache/centreon/config/broker \
  /var/cache/centreon/config/engine \
  /var/cache/centreon/config/vmware \
  /var/log/centreon-engine \
  /var/log/centreon-gorgone \
  /var/log/centreon-broker \
  /var/log/centreon \
  /var/log/httpd \
  /var/log/php-fpm \
  /run/httpd \
  /run/php-fpm \
  /var/lib/php/session \
  /var/lib/php/wsdlcache \
  /var/lib/php/opcache \
  /tmp

/usr/local/bin/fix-permissions /etc/sysconfig
/usr/local/bin/fix-permissions /var/lib/centreon
/usr/local/bin/fix-permissions /var/cache/centreon
/usr/local/bin/fix-permissions /var/log/centreon-engine
/usr/local/bin/fix-permissions /var/log/centreon-broker
/usr/local/bin/fix-permissions /var/log/centreon-gorgone
/usr/local/bin/fix-permissions /var/log/centreon
/usr/local/bin/fix-permissions /var/log/httpd
/usr/local/bin/fix-permissions /var/log/php-fpm
/usr/local/bin/fix-permissions /run/httpd
/usr/local/bin/fix-permissions /run/php-fpm
/usr/local/bin/fix-permissions /var/lib/php/session
/usr/local/bin/fix-permissions /var/lib/php/wsdlcache
/usr/local/bin/fix-permissions /var/lib/php/opcache
/usr/local/bin/fix-permissions /usr/share/centreon
/usr/local/bin/fix-permissions /tmp

# Allow non-nagios users to execute check_icmp (setuid root)
chgrp 0 /usr/lib64/nagios/plugins/check_icmp
chmod 4755 /usr/lib64/nagios/plugins/check_icmp

# -----------------------------------------------------------------------------
# 3) /etc/passwd: random UID -> name resolution
# -----------------------------------------------------------------------------
chgrp 0 /etc/passwd
chmod g+rw /etc/passwd
EOF

# group-root membership logic since we rely on GID 0 access patterns.
RUN bash -e <<'EOF'
set -euo pipefail
root_members="$(getent group root | cut -d: -f4 || true)"
for user in apache www-data centreon centreon-gorgone centreon-engine centreon-broker; do
  if id "$user" >/dev/null 2>&1; then
    usermod -a -G root "$user"
    case ",${root_members}," in
      *",${user},"*) ;;
      *) root_members="${root_members:+${root_members},}${user}" ;;
    esac
  fi
done
sed -i "s/^root:[^:]*:0:.*/root:x:0:${root_members}/" /etc/group

dnf install -y patch

# Apply patches with --forward to skip already-applied patches
patch -N -p1 -d / -i /tmp/ignore-vmware-chgrp.patch || true
rm -f /tmp/ignore-vmware-chgrp.patch

# Disable ownership changes in CLAPI poller generation for OpenShift
/usr/local/bin/fix-poller-gen.py

# Apply common entrypoint patches
patch -N -p6 -d /usr/share/centreon -i /tmp/00-init.sh.patch || true
rm -f /tmp/00-init.sh.patch
patch -N -p5 -d /bin -i /tmp/systemctl.patch || true
rm -f /tmp/systemctl.patch

# Apply web-specific patches with different strip levels
patch -N -p1 -d / -i /tmp/web-patches/apache-listen-8080.patch || true
rm -f /tmp/web-patches/apache-listen-8080.patch
patch -N -p6 -d /usr/share/centreon/www/install/tmp -i /tmp/web-patches/broker.json.patch || true
rm -f /tmp/web-patches/broker.json.patch

# Apply web entrypoint patches (strip .github/docker/centreon-web/alma9/entrypoint/ prefix)
for p in /tmp/web-patches/*.patch; do
  if ! patch --batch --forward -N -p6 -d /usr/share/centreon -i "$p"; then
    echo "Failed to apply web patch: $p"
    exit 1
  fi
done
rm -rf /tmp/web-patches

dnf clean all
EOF

# Fix HTTPD & PHP-FPM configuration for Openshift
RUN mv /etc/php-fpm.d/centreon.conf /etc/php-fpm.d/centreon.conf.rpm
COPY --chmod=755 ./web/config/php-fpm/centreon.conf /etc/php-fpm.d/centreon.conf
RUN mv /etc/httpd/conf.d/10-centreon.conf /etc/httpd/conf.d/10-centreon.conf.rpm
COPY --chmod=755 ./web/config/httpd/10-centreon.conf /etc/httpd/conf.d/10-centreon.conf
COPY --chmod=755 ./web/config/httpd/zzz-openshift-runtime.conf /etc/httpd/conf.d/zzz-openshift-runtime.conf

EXPOSE 8080
