ARG REGISTRY_URL=docker.centreon.com/centreon
ARG FROM_IMAGE_VERSION=develop

FROM ${REGISTRY_URL}/centreon-web-bookworm:${FROM_IMAGE_VERSION}

###############################################################################
# OpenShift compatibility overlay (Bookworm)
###############################################################################

# OpenShift helpers
COPY --chmod=755 ./common/fix-permissions /usr/local/bin/fix-permissions
COPY --chmod=440 ./common/openshift/sudoers /etc/sudoers.d/centreon-openshift
COPY --chmod=755 ./common/openshift/sudo-wrapper /usr/local/bin/sudo

COPY --chmod=660 ./common/openshift/patches/poller-generate-disable-ownership.patch /tmp/poller-generate-disable-ownership.patch

COPY --chmod=755 ./web/config/php-fpm-debian/centreon.conf /tmp/centreon-php-fpm.conf
COPY --chmod=755 ./web/config/apache2/centreon.conf /tmp/centreon-apache.conf
COPY --chmod=755 ./web/config/apache2/ports.conf /tmp/ports.conf
COPY --chmod=755 ./web/config/apache2/zzz-openshift-runtime.conf /tmp/zzz-openshift-runtime.conf

RUN bash -e <<'EOF'
set -euo pipefail

# Replace sudo with wrapper
if [ -x /usr/bin/sudo ]; then
  mv /usr/bin/sudo /usr/bin/sudo.real
fi
ln -sf /usr/local/bin/sudo /usr/bin/sudo

# Uncomment include directory for specific Openshift sudoers file
sed -i 's/^#includedir/includedir/' /etc/sudoers || true

# -----------------------------------------------------------------------------
# 1) Relocate mutable /etc trees
# -----------------------------------------------------------------------------
mkdir -p /var/lib/centreon/

relocate_tree() {
  src="$1"
  name="$2"
  dst="/var/lib/centreon/${name}"

  mkdir -p "$dst"

  if [ -e "$src" ] && [ ! -L "$src" ]; then
    cp -a "$src"/. "$dst"/ 2>/dev/null || true
    rm -rf "$src"
  fi

  mkdir -p "$(dirname "$src")"
  ln -sfn "$dst" "$src"
}

relocate_tree /etc/centreon         etc/centreon
relocate_tree /etc/centreon-broker  etc/centreon-broker
relocate_tree /etc/centreon-gorgone etc/centreon-gorgone
relocate_tree /etc/centreon-engine  etc/centreon-engine
relocate_tree /var/lib/centreon-engine  var/lib/centreon-engine
relocate_tree /var/lib/centreon-broker  var/lib/centreon-broker
relocate_tree /var/lib/centreon-gorgone  var/lib/centreon-engine
relocate_tree /usr/share/centreon/www/install/tmp install/tmp

# -----------------------------------------------------------------------------
# 2) Create + fix permissions for runtime/state paths
# -----------------------------------------------------------------------------
mkdir -p \
  /var/lib/centreon \
  /var/cache/centreon/config/broker \
  /var/cache/centreon/config/engine \
  /var/cache/centreon/config/vmware \
  /var/log/centreon-engine \
  /var/log/centreon-gorgone \
  /var/log/centreon-broker \
  /var/log/centreon \
  /var/log/apache2 \
  /var/log/php-fpm \
  /run/apache2 \
  /run/php-fpm \
  /var/lib/php/session \
  /var/lib/php/wsdlcache \
  /var/lib/php/opcache \
  /tmp

/usr/local/bin/fix-permissions /var/lib/centreon
/usr/local/bin/fix-permissions /var/cache/centreon
/usr/local/bin/fix-permissions /var/log/centreon-engine
/usr/local/bin/fix-permissions /var/log/centreon-broker
/usr/local/bin/fix-permissions /var/log/centreon-gorgone
/usr/local/bin/fix-permissions /var/log/centreon
/usr/local/bin/fix-permissions /var/log/apache2
/usr/local/bin/fix-permissions /var/log/php-fpm
/usr/local/bin/fix-permissions /run/apache2
/usr/local/bin/fix-permissions /run/php-fpm
/usr/local/bin/fix-permissions /var/lib/php/session
/usr/local/bin/fix-permissions /var/lib/php/wsdlcache
/usr/local/bin/fix-permissions /var/lib/php/opcache
/usr/local/bin/fix-permissions /usr/share/centreon
/usr/local/bin/fix-permissions /tmp

# -----------------------------------------------------------------------------
# 3) /etc/passwd: random UID -> name resolution
# -----------------------------------------------------------------------------
chgrp 0 /etc/passwd
chmod g+rw /etc/passwd

# Patch if needed
if ! command -v patch >/dev/null 2>&1; then
  apt-get update
  apt-get install -y patch
  apt-get clean
fi
patch -p1 -d / -i /tmp/poller-generate-disable-ownership.patch \
 && rm -f /tmp/poller-generate-disable-ownership.patch

# PHP-FPM (Debian layout)
if [ -f /etc/php/8.2/fpm/pool.d/centreon.conf ]; then
  mv /etc/php/8.2/fpm/pool.d/centreon.conf /etc/php/8.2/fpm/pool.d/centreon.conf.rpm
fi
cp /tmp/centreon-php-fpm.conf /etc/php/8.2/fpm/pool.d/centreon.conf

# Apache2 (Debian layout)
if [ -f /etc/apache2/ports.conf ]; then
  mv /etc/apache2/ports.conf /etc/apache2/ports.conf.rpm
fi
cp /tmp/ports.conf /etc/apache2/ports.conf

if [ -f /etc/apache2/sites-available/centreon.conf ]; then
  mv /etc/apache2/sites-available/centreon.conf /etc/apache2/sites-available/centreon.conf.rpm
  cp /tmp/centreon-apache.conf /etc/apache2/sites-available/centreon.conf
  command -v a2ensite >/dev/null 2>&1 && a2ensite centreon.conf || true
elif [ -f /etc/apache2/conf-available/centreon.conf ]; then
  mv /etc/apache2/conf-available/centreon.conf /etc/apache2/conf-available/centreon.conf.rpm
  cp /tmp/centreon-apache.conf /etc/apache2/conf-available/centreon.conf
  command -v a2enconf >/dev/null 2>&1 && a2enconf centreon.conf || true
elif [ -f /etc/apache2/conf-enabled/centreon.conf ]; then
  mv /etc/apache2/conf-enabled/centreon.conf /etc/apache2/conf-enabled/centreon.conf.rpm
  cp /tmp/centreon-apache.conf /etc/apache2/conf-enabled/centreon.conf
fi

cp /tmp/zzz-openshift-runtime.conf /etc/apache2/conf-available/zzz-openshift-runtime.conf
command -v a2enconf >/dev/null 2>&1 && a2enconf zzz-openshift-runtime.conf || true
ln -sf /etc/apache2/conf-available/zzz-openshift-runtime.conf /etc/apache2/conf-enabled/zzz-openshift-runtime.conf
EOF

EXPOSE 8080
